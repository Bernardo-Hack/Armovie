generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Table for all info related to machines
model Machine {
  id String @id @default(uuid(7)) @db.Uuid

  name         String  @db.VarChar(128)
  model        String  @db.VarChar(64)
  observations String? @db.Text

  contractId        String? @db.Uuid
  localInstalled    String? @db.VarChar(128)
  fragranceId       String? @db.Uuid
  medianConsumption Float?  @db.DoublePrecision

  price      Float @db.DoublePrecision
  amountPaid Float @db.DoublePrecision

  status String @default("Disponível") @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceLogs    ServiceLog[]
  operatingHours OperatingHours[]
  fragrance      Fragrance?       @relation(fields: [fragranceId], references: [id])

  @@index([model])
  @@index([status])
  @@index([contractId])
  @@map("machines")
}

// Table for machine operating hours and timing grades
model OperatingHours {
  id String @id @default(uuid(7)) @db.Uuid

  machineId     String  @db.Uuid
  contractId    String? @db.Uuid
  timingGradeId String  @db.Uuid

  startTime DateTime @db.Time
  endTime   DateTime @db.Time

  monday    Boolean @db.Boolean
  tuesday   Boolean @db.Boolean
  wednesday Boolean @db.Boolean
  thursday  Boolean @db.Boolean
  friday    Boolean @db.Boolean
  saturday  Boolean @db.Boolean
  sunday    Boolean @db.Boolean

  createdAt DateTime @default(now())

  machine     Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  timingGrade TimingGrade @relation(fields: [timingGradeId], references: [id])

  @@index([machineId])
  @@map("operatingHours")
}

// Defines the timing grade for machines
model TimingGrade {
  id String @id @default(uuid(7)) @db.Uuid

  name     String @db.VarChar(32)
  interval Float  @db.DoublePrecision // interval in minutes between each splash

  operatingHours OperatingHours[]

  @@map("grades")
}

// Logs each service performed on machines
model ServiceLog {
  id String @id @default(uuid(7)) @db.Uuid

  machineId    String @db.Uuid
  technicianId String @db.Uuid

  appointmentId String? @db.Uuid // reference to the originating ms-schedule Appointment

  serviceId      String @db.Uuid
  description    String @db.Text
  machinePayment Int    @db.Integer

  mlBefore    Int?    @db.Integer
  mlAfter     Int?    @db.Integer
  fragranceId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Date

  machine     Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceId], references: [id])
  fragrance   Fragrance?  @relation(fields: [fragranceId], references: [id])

  @@index([machineId])
  @@index([technicianId])
  @@map("serviceLogs")
}

// Types of services performed on machines
model ServiceType {
  id String @id @default(uuid(7)) @db.Uuid

  name        String @db.VarChar(32)
  description String @db.Text

  serviceLogs ServiceLog[]

  @@map("serviceTypes")
}

// Milliliter steps for each service performed on machines
model MlSteps {
  id String @id @default(uuid(7)) @db.Uuid

  quantity Int @db.Integer

  @@map("mlSteps")
}

// Table for fragrances
model Fragrance {
  id String @id @default(uuid(7)) @db.Uuid

  name        String @db.VarChar(128)
  family      String @db.VarChar(64)
  description String @db.Text

  stock      Int    @db.Integer // milliliters in stock
  minStock   Int    @default(200) @db.Integer // alert threshold in milliliters
  unitCost   Float  @db.DoublePrecision // price per 100ml
  supplierId String @db.Uuid

  isActive Boolean @db.Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  machines        Machine[]
  serviceLogs     ServiceLog[]
  consumptionLogs ConsumptionLog[]

  @@index([family])
  @@index([supplierId])
  @@index([isActive])
  @@map("fragrances")
}

// Table for fragrance suppliers
model Supplier {
  id String @id @default(uuid(7)) @db.Uuid

  name        String @db.VarChar(128)
  description String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fragrances Fragrance[]

  @@map("suppliers")
}

// Logs the consumption of fragrances in stock
model ConsumptionLog {
  id String @id @default(uuid(7)) @db.Uuid

  fragranceId String   @db.Uuid
  month       DateTime @db.Date
  mlConsumed  Int      @db.Integer

  createdAt DateTime @default(now())

  fragrance Fragrance @relation(fields: [fragranceId], references: [id], onDelete: Cascade)

  @@index([fragranceId])
  @@map("consumptionLogs")
}
