generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id String @id @default(uuid()) @db.Uuid

  clientId     String  @db.Uuid
  technicianId String? @db.Uuid
  machineId    String? @db.Uuid

  scheduledDate     DateTime
  estimatedDuration Int?     @db.Integer

  type   String @db.VarChar(16)
  status String @default("Pendente") @db.VarChar(16)

  routeOrder Int? @db.Integer

  startedAt  DateTime?
  finishedAt DateTime?

  notes         String?   @db.Text
  nextVisitDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklist ChecklistItem[]

  @@index([clientId])
  @@index([technicianId])
  @@index([scheduledDate])
  @@index([status])
  @@index([type])
  @@map("appointments")
}

model ChecklistItem {
  id            String @id @default(uuid()) @db.Uuid
  appointmentId String @db.Uuid

  label String  @db.VarChar(256)
  done  Boolean @default(false) @db.Boolean
  order Int     @db.Integer // display order within the checklist

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("checklist_items")
}
