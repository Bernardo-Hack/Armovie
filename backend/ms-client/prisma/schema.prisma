generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id String @id @default(uuid()) @db.Uuid

  fullName    String  @db.VarChar(128) // Razão Social
  fantasyName String? @db.VarChar(128)

  document        String  @unique @db.VarChar(32)
  municipalID     String? @unique @db.VarChar(128)
  stateID         String? @unique @db.VarChar(128)
  fieldOfActivity String? @db.Text

  phone    String @db.VarChar(32)
  whatsapp String @db.VarChar(32)

  hasIss Boolean @db.Boolean

  financesEmail String  @unique @db.VarChar(128)
  alertsEmail   String? @db.VarChar(128)

  foundingDate DateTime @db.Date
  observations String?  @db.Text

  sellerId String @db.Uuid

  status String @default("Em Análise") @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address   Address[]
  contracts Contract[]
  persons   Person[]

  @@index([sellerId])
  @@index([status])
  @@map("clients")
}

model Person {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  fullName String @db.VarChar(128)
  document String @unique @db.VarChar(16)

  birthday    DateTime @db.Date
  civilState  String   @db.VarChar(16)
  nationality String   @db.VarChar(32)

  doesSign      Boolean @db.Boolean
  doesRepresent Boolean @db.Boolean
  role          String  @db.VarChar(32)

  email        String  @db.VarChar(128)
  phone        String  @db.VarChar(32)
  observations String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addresses Address[]

  @@index([clientId])
  @@map("persons")
}

model Address {
  id       String  @id @default(uuid()) @db.Uuid
  clientId String? @db.Uuid
  personId String? @db.Uuid

  zipCode      String  @db.VarChar(32)
  street       String  @db.VarChar(256)
  number       Int     @db.Integer
  neighborhood String  @db.VarChar(256)
  city         String  @db.VarChar(128)
  state        String  @db.VarChar(64)
  complement   String? @db.VarChar(128)
  observations String? @db.Text

  client   Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  person   Person?    @relation(fields: [personId], references: [id], onDelete: Cascade)
  contract Contract[]

  @@index(fields: [city, state], name: "city_state_idx")
  @@map("addresses")
}

model Contract {
  id String @id @default(uuid()) @db.Uuid

  name      String @db.VarChar(128)
  clientId  String @db.Uuid
  addressId String @db.Uuid

  type       String @db.VarChar(16)
  planId     String @db.Uuid
  templateId String @db.Uuid

  machines  Int
  fragrance String   @db.Uuid
  endDate   DateTime @db.Date

  monthlyValue Float
  payDay       Int
  observations String? @db.Text

  status String @default("Em Análise") @db.VarChar(16)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address  Address   @relation(fields: [addressId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  template Template? @relation(fields: [templateId], references: [id])

  @@index([clientId])
  @@index([type])
  @@index([planId])
  @@index([templateId])
  @@index([status])
  @@map("contracts")
}

model Plan {
  id String @id @default(uuid()) @db.Uuid

  name  String @db.VarChar(128)
  price Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts Contract[]

  @@map("plans")
}

model Template {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique @db.VarChar(128)
  description String? @db.Text
  content     String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts Contract[]

  @@map("templates")
}
