generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id String @id @default(uuid()) @db.Uuid

  fullName    String  @db.VarChar(128) // Razão Social
  fantasyName String? @db.VarChar(128)

  document    String  @unique @db.VarChar(32)
  municipalID String? @unique @db.VarChar(128)
  stateID     String? @unique @db.VarChar(128)

  fieldOfActivity String? @db.Text
  lead            String  @db.VarChar(16)
  segment         String  @db.VarChar(16)

  phone    String @db.VarChar(32)
  whatsapp String @db.VarChar(32)

  hasIss Boolean @db.Boolean

  financesEmail String  @unique @db.VarChar(128)
  alertsEmail   String? @db.VarChar(128)

  foundingDate DateTime @db.Date
  observations String?  @db.Text

  sellerId String @db.Uuid

  status String @default("Em Análise") @db.VarChar(16)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  address   Address[]
  contracts Contract[]
  persons   Person[]

  @@index([lead])
  @@index([segment])
  @@index([sellerId])
  @@index([status])
  @@map("clients")
}

model Person {
  id  String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  rg  String @unique @db.VarChar(16)
  cpf String @unique @db.VarChar(16)

  birthday    DateTime @db.Date
  civilState  String   @db.VarChar(16)
  nationality String   @db.VarChar(32)

  doesSign Boolean @db.Boolean
  isRepresentative Boolean @db.Boolean
  role     String  @db.VarChar(32)

  email        String  @db.VarChar(128)
  phone        String  @db.VarChar(32)
  observations String? @db.Text

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addresses Address[]
  @@index([clientId])
  @@map("persons")
}

model Address {
  id       String @id @default(uuid()) @db.Uuid
  clientId String? @db.Uuid
  personId String? @db.Uuid

  street     String  @db.VarChar(256)
  number     Int     @db.Integer
  zip_code   String  @db.VarChar(32)
  city       String  @db.VarChar(64)
  state      String  @db.VarChar(64)
  complement String? @db.VarChar(128)

  client   Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  person   Person?    @relation(fields: [personId], references: [id], onDelete: Cascade)
  contract Contract[]

  @@index(fields: [city, state], name: "city_state_idx")
  @@map("addresses")
}

model Contract {
  id String @id @default(uuid()) @db.Uuid

  name       String @db.VarChar(128)
  clientId   String @db.Uuid
  addressId  String @db.Uuid
  templateId String @db.Uuid
  planId     String @db.Uuid
  type       String @db.VarChar(16)

  machines  Int
  fragrance String @db.Uuid
  duration  Int // in days

  monthlyValue Float
  paymentDay   Int
  observations String? @db.Text

  status String @default("Em Análise") @db.VarChar(16)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address  Address   @relation(fields: [addressId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  template Template? @relation(fields: [templateId], references: [id])

  @@index([clientId])
  @@index([type])
  @@index([planId])
  @@index([templateId])
  @@index([status])
  @@map("contracts")
}

model Plan {
  id String @id @default(uuid()) @db.Uuid

  name  String @db.VarChar(128)
  price Float

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contracts Contract[]

  @@map("plans")
}

model Template {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique @db.VarChar(128)
  description String? @db.Text
  content     String  @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contracts Contract[]

  @@map("templates")
}
