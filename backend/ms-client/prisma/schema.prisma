generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id String @id @default(uuid()) @db.Uuid

  name         String  @db.VarChar(128)
  document     String  @unique @db.VarChar(16)
  responsible  String  @db.VarChar(128)
  email        String  @unique @db.VarChar(128)
  phone        String  @db.VarChar(32)
  whatsapp     String  @db.VarChar(32)

  lead         Lead
  segment      Segment
  sellerId     String  @db.Uuid
  observations String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  address Address[]
  contracts Contract[]

  @@index([lead])
  @@index([segment])
  @@index([sellerId])
  @@map("clients")
}

enum Segment {
  Retail
  Hospitality
  Healthcare
  Gastronomy
  Other
}

enum Lead {
  Instagram
  GoogleAds
  Referral
  Other
}

model Address {
  id String @id @default(uuid()) @db.Uuid

  street   String @db.VarChar(256)
  number   String @db.VarChar(8)
  zip_code String @db.VarChar(32)
  city     String @db.VarChar(64)
  state    String @db.VarChar(64)
  clientId String @db.Uuid

  client   Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract Contract[]

  @@index(fields: [city, state], name: "city_state_idx")
  @@map("addresses")
}

model Contract {
  id String @id @default(uuid()) @db.Uuid

  clientId     String       @db.Uuid
  addressId    String       @db.Uuid
  templateId   String       @db.Uuid
  planId       String       @db.Uuid
  type         ContractType

  machines     Int
  fragrance    String       @db.Uuid
  duration     Int // in days

  monthlyValue Float
  paymentDay   Int
  observations String?      @db.Text

  status String @default("active") @db.VarChar(16)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address  Address   @relation(fields: [addressId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  template Template? @relation(fields: [templateId], references: [id])

  @@index([clientId])
  @@index([type])
  @@index([planId])
  @@index([templateId])
  @@index([status])
  @@map("contracts")
}

enum ContractType {
  Subscription
  Rental
  Sale
  Loan
}

model Plan {
  id String @id @default(uuid()) @db.Uuid

  name  String @db.VarChar(128)
  price Float

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contracts Contract[]

  @@map("plans")
}

model Template {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique @db.VarChar(128)
  description String? @db.Text
  content     String  @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contracts Contract[]

  @@map("templates")
}
