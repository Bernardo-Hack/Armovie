# ──────────────────────────────────────────────────────────────────────────────
# Armovie – .env.example (raiz do projeto / docker-compose)
#
# Renomeie este arquivo para .env e preencha os valores antes de subir
# os containers com: docker compose up -d
#
# Gere o JWT_SECRET com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_SEGURA

# ── JWT (deve ser o mesmo valor em gateway e ms-user) ─────────────────────────
JWT_SECRET=TROQUE_POR_UM_SEGREDO_SEGURO_64_BYTES_HEX

# ── Gateway ────────────────────────────────────────────────────────────────────
# URL do front-end para CORS – em produção use o domínio real
FRONTEND_URL=http://localhost:8081

# ── E-mail (ms-user / Nodemailer) ─────────────────────────────────────────────
# Provedor: gmail | outlook | hotmail | yahoo | etc.
EMAIL_PROVIDER=gmail
EMAIL_ADDRESS=seu-email@gmail.com
# Para Gmail com 2FA, use um App Password: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=TROQUE_PELA_SENHA_OU_APP_PASSWORD
